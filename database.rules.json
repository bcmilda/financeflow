// FinanceFlow · database rules · v10.30 · 2026-09-02 (S21 FIX-307: community/$monthKey/users je nove klicovany PSEUDONYMEM z users/{uid}/communityId, ne uid. Zapis smi jen ten, komu pseudonym patri; mazani sveho stareho uid-klicovaneho zaznamu je povolene kvuli migraci. Uzel stripeEvents zapisuje VYHRADNE worker pres Database Secret (obchazi pravidla) – klientovi je zapovezen tim, ze tu neni uveden.)
{
  "rules": {
    "users": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
        ".write": "auth.uid === $uid",
        "data": {
          ".read": "auth.uid === $uid || root.child('users').child($uid).child('partners').child(auth.uid).exists() || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",          "transactions": {
            "$txId": {
              "name": {
                ".validate": "!newData.isString() || newData.val().length < 300"
              },
              "note": {
                ".validate": "!newData.isString() || newData.val().length < 1000"
              }
            }
          },
          "milestones": {
            "$msId": {
              "label": {
                ".validate": "!newData.isString() || newData.val().length < 200"
              },
              "note": {
                ".validate": "!newData.isString() || newData.val().length < 600"
              },
              "icon": {
                ".validate": "!newData.isString() || newData.val().length < 16"
              }
            }
          }
        },
        "profile": {
          ".read": "auth != null"
        },
        "premium": {
          ".read": "auth.uid === $uid || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
          ".write": "auth.uid === $uid || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
          "type": {
            ".validate": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1' || newData.val() === 'trial' || newData.val() === 'free'"
          },
          "premiumUntil": {
            ".validate": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1' || newData.val() <= now"
          },
          "trialUntil": {
            ".validate": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1' || newData.val() <= now + 2764800000"
          },
          "trialUsed": {
            ".validate": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1' || !data.exists() || data.val() !== true || newData.val() === true"
          }
        },
        "shared": {
          ".read": "auth.uid === $uid || root.child('users').child($uid).child('partners').child(auth.uid).exists() || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
          "transactions": {
            "$txId": {
              "name": {
                ".validate": "!newData.isString() || newData.val().length < 300"
              },
              "note": {
                ".validate": "!newData.isString() || newData.val().length < 1000"
              }
            }
          }
        },
        "settings": {
          ".read": "auth.uid === $uid"
        },
        "partners": {
          ".read": "auth.uid === $uid",
          // FIX-312 (S21): tenhle uzel znamena "kdo smi cist ME". Zapsat sem smi vlastnik
          //   vzdy; POZVANY navic sam sebe, kdyz predlozi platny token z users/{uid}/invites.
          //   Diky tomu jedno kliknuti na pozvanku propoji OBE strany - dosud musel kazdy
          //   pridat toho druheho zvlast a nez to udelali oba, nevidel nikdo nic.
          // POZOR: komentar musi byt radkovy. Klic "//" s textovou hodnotou Firebase chape
          //   jako nazev uzlu a spadne na: Syntax error ... Expected '{'.
          "$pid": {
            ".write": "auth.uid === $uid || (auth.uid === $pid && !data.exists() && newData.exists() && root.child('users').child($uid).child('invites').child(newData.child('token').val()).val() === true)",
            ".validate": "newData.isBoolean() || (newData.hasChildren(['token']) && newData.child('token').isString() && newData.child('token').val().length < 64)"
          }
        },
        // Pozvankove tokeny. Cte a zapisuje jen vlastnik; pravidlo vyse si hodnotu overuje
        //   serverove pres root.child(), na to cteci pravo potreba neni.
        //   Smazanim tokenu prestane odkaz platit.
        "invites": {
          ".read": "auth.uid === $uid",
          "$token": {
            ".validate": "newData.isBoolean()"
          }
        },
        "categoryMappings": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid",
          "$key": {
            ".validate": "newData.hasChildren([\"catId\",\"updatedAt\"]) && newData.child(\"catId\").isString() && newData.child(\"catId\").val().length > 0"
          }
        },
        "itemStats": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid",
          "$itemKey": {
            ".validate": "newData.hasChildren([\"name\",\"count\",\"avgPrice\",\"updatedAt\"]) || newData.hasChildren([\"name\",\"count\",\"avgPrice\",\"lastDate\"])"
          }
        },
        "aiUsage": {
          ".read": "auth.uid === $uid || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
          "$month": {
            "$type": {
              ".validate": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1' || !data.exists() || newData.val() >= data.val()"
            }
          }
        }
      }
    },
    "leads": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$leadId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "(newData.hasChildren(['name']) || newData.hasChildren(['email']) || newData.hasChildren(['phone'])) && (!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length < 200)) && (!newData.child('email').exists() || (newData.child('email').isString() && newData.child('email').val().length < 200)) && (!newData.child('phone').exists() || (newData.child('phone').isString() && newData.child('phone').val().length < 50))"
      }
    },
    "affiliate": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$affId": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "trialsUsed": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','at'])"
      }
    },
    "banned": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
        ".write": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'"
      }
    },
    "premiumLog": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      ".write": false
    },
    "stats": {
      "founderCount": {
        ".read": true,
        ".write": false
      }
    },
    "stripeCustomers": {
      "$customerId": {
        ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
        ".write": false
      }
    },
    "community": {
      "$monthKey": {
        "users": {
          "$pid": {
            ".read": "root.child('users').child(auth.uid).child('communityId').val() === $pid || auth.uid === $pid || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
            ".write": "root.child('users').child(auth.uid).child('communityId').val() === $pid || (auth.uid === $pid && !newData.exists())",
            ".validate": "newData.hasChildren(['updatedAt'])"
          }
        },
        "aggregate": {
          ".read": "auth != null",
          ".write": false
        }
      },
      "itemTags": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$itemKey": {
          "$tag": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      "itemTagValidation": {
        ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
        ".write": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'"
      },
      "suggestionOverrides": {
        ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
        ".write": "auth != null"
      }
    },
    "catalog": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$item": {
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 60"
      },
      "prices": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$product": {
          "$record": {
            ".validate": "newData.hasChildren(['price','date','store']) && newData.child('price').isNumber() && newData.child('price').val() > 0"
          }
        }
      },
      "items": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$itemKey": {
          ".validate": "newData.hasChildren(['name'])"
        }
      }
    },
    "referrals": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$refCode": {
        ".validate": "newData.hasChildren(['uid','createdAt'])"
      }
    },
    "referral_clicks": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      ".write": "auth != null"
    },
    "keyword_overrides": {
      ".read": "auth != null",
      ".write": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'"
    },
    "coicop_corrections": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      ".write": "auth != null",
      "$uid": {
        ".write": "auth.uid === $uid || auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'"
      }
    },
    "admin_coicop_overrides": {
      ".read": "auth != null",
      ".write": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$catId": {
        ".validate": "newData.hasChildren(['coicop','name','assignedAt']) && newData.child('coicop').isNumber() && newData.child('coicop').val() >= 0 && newData.child('coicop').val() <= 13"
      },
      "subs": {
        ".read": "auth != null",
        ".write": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "support": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      ".write": "auth != null",
      "$entry": {
        ".validate": "newData.hasChildren(['email','message','date'])"
      }
    },
    "welcomeMessage": {
      ".read": "auth != null",
      ".write": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'"
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$id": {
        ".validate": "newData.hasChildren(['title','type','createdAt'])"
      }
    },
    "poll_votes": {
      ".read": "auth != null",
      "$pollId": {
        "$uid": {
          ".write": "auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "push_subs": {
      ".read": "auth.uid === 'LNEC8VNB2QPwIv6WWQ9lqgR4O5v1'",
      "$key": {
        ".write": "auth != null",
        ".validate": "newData.child('uid').val() === auth.uid"
      }
    },
    "reviews": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['stars','at'])",
        "stars": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "text": {
          ".validate": "!newData.isString() || newData.val().length <= 600"
        },
        "name": {
          ".validate": "!newData.isString() || newData.val().length <= 80"
        },
        "ver": {
          ".validate": "!newData.isString() || newData.val().length <= 20"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
